{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lunifans/rinspace-web/contracts/world-routes.schema.json",
  "title": "Rinspace world route contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "generatedFrom",
    "worldQuery",
    "resolutionOrder",
    "manifestCoverage",
    "routes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "rinspace-world-routes/v1"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generatedFrom": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "worldQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter",
        "innerValue",
        "outerRepresentation",
        "invalidValue"
      ],
      "properties": {
        "parameter": { "const": "world" },
        "innerValue": { "const": "inner" },
        "outerRepresentation": { "const": "omitted" },
        "invalidValue": { "const": "strip-and-use-route-default" }
      }
    },
    "resolutionOrder": {
      "type": "array",
      "const": [
        "service",
        "federation-disabled",
        "reserved",
        "inner-only",
        "dual",
        "outer-only",
        "unmatched"
      ]
    },
    "manifestCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeCount", "orderedPathSha256"],
      "properties": {
        "routeCount": { "type": "integer", "minimum": 1 },
        "orderedPathSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pattern",
        "kind",
        "priority",
        "owners",
        "anonymousPolicy",
        "flip",
        "canonicalWorld",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        },
        "pattern": {
          "type": "string",
          "pattern": "^(\\*|/.*)$"
        },
        "kind": {
          "enum": [
            "dual",
            "outer-only",
            "inner-only",
            "service",
            "federation-disabled",
            "reserved"
          ]
        },
        "priority": { "type": "integer", "minimum": 0 },
        "owners": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["rinspace-web", "mastodon", "rinspace-private", "blocked"]
          }
        },
        "anonymousPolicy": {
          "enum": [
            "public",
            "authenticated",
            "runtime-policy",
            "service-policy",
            "blocked"
          ]
        },
        "flip": {
          "enum": ["same-path", "binding", "opposite-home", "none"]
        },
        "canonicalWorld": {
          "enum": ["query-for-inner", "path-owned", "not-applicable"]
        },
        "source": {
          "enum": ["rinspace-web-manifest", "shared-contract"]
        },
        "manifestOrder": { "type": "integer", "minimum": 0 },
        "canonicalPath": { "type": "string" },
        "minimumRole": { "type": "string" }
      }
    }
  }
}
