{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rinspacehq/rinspace-web/contracts/rinspace-stack-baseline.schema.json",
  "title": "Rinspace stack development baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordedOn",
    "status",
    "components",
    "compatibility",
    "forkPatchPolicy"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "rinspace-stack-baseline/v1" },
    "recordedOn": { "type": "string", "format": "date" },
    "status": { "const": "development-baseline" },
    "components": {
      "type": "object",
      "required": ["rinspaceWeb", "mastodon", "rinspacePrivate"]
    },
    "compatibility": {
      "type": "object",
      "required": [
        "worldRouteContract",
        "worldShell",
        "reactPeer",
        "releaseRule",
        "floatingReferencesAllowed"
      ]
    },
    "forkPatchPolicy": {
      "type": "object",
      "required": ["categories", "requiredEvidence"]
    }
  }
}
