{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rinspacehq/rinspace-web/schemas/private-release-rehearsal.schema.json",
  "title": "Rinspace Web private release rehearsal evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "repositoryVisibility",
    "commit",
    "tag",
    "previousTag",
    "checks",
    "verifiedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "const": "rinspacehq/rinspace-web" },
    "repositoryVisibility": { "const": "private" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tag": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "previousTag": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanClone",
        "readmeQuickStart",
        "releaseReadiness",
        "sourcePolicy",
        "unitCoverage",
        "rootSubpathPackages",
        "browserMatrix",
        "mobileThemesMotionA11y",
        "networkFailClosed",
        "containerCompose",
        "staticHostPreview",
        "sourceHistoryScan",
        "releaseAttachments",
        "containerLayers",
        "sbom",
        "actionsLogs",
        "screenshots",
        "rollbackDemoData"
      ],
      "properties": {
        "cleanClone": { "$ref": "#/$defs/passingCheck" },
        "readmeQuickStart": { "$ref": "#/$defs/passingCheck" },
        "releaseReadiness": { "$ref": "#/$defs/passingCheck" },
        "sourcePolicy": { "$ref": "#/$defs/passingCheck" },
        "unitCoverage": { "$ref": "#/$defs/passingCheck" },
        "rootSubpathPackages": { "$ref": "#/$defs/passingCheck" },
        "browserMatrix": { "$ref": "#/$defs/passingCheck" },
        "mobileThemesMotionA11y": { "$ref": "#/$defs/passingCheck" },
        "networkFailClosed": { "$ref": "#/$defs/passingCheck" },
        "containerCompose": { "$ref": "#/$defs/passingCheck" },
        "staticHostPreview": { "$ref": "#/$defs/passingCheck" },
        "sourceHistoryScan": { "$ref": "#/$defs/passingCheck" },
        "releaseAttachments": { "$ref": "#/$defs/passingCheck" },
        "containerLayers": { "$ref": "#/$defs/passingCheck" },
        "sbom": { "$ref": "#/$defs/passingCheck" },
        "actionsLogs": { "$ref": "#/$defs/passingCheck" },
        "screenshots": { "$ref": "#/$defs/passingCheck" },
        "rollbackDemoData": { "$ref": "#/$defs/passingCheck" }
      }
    },
    "verifiedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "passingCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference"],
      "properties": {
        "status": { "const": "passed" },
        "reference": { "type": "string", "minLength": 3 }
      }
    }
  }
}
