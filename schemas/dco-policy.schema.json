{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rinspacehq/rinspace-web/schemas/dco-policy.schema.json",
  "title": "Rinspace Web DCO policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "repository", "documents", "signoffPolicy", "botExemptions", "largeOrCorporateContributions", "blockers"],
  "properties": {
    "$schema": { "const": "../schemas/dco-policy.schema.json" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "operational" },
    "repository": { "const": "rinspacehq/rinspace-web" },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dco", "contributionLicense"],
      "properties": {
        "dco": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "version", "sha256"],
          "properties": {
            "path": { "const": "DCO" },
            "version": { "const": "1.1" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "contributionLicense": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "version", "spdxIdentifier", "sha256"],
          "properties": {
            "path": { "const": "CONTRIBUTION-LICENSE.md" },
            "version": { "const": "1.0" },
            "spdxIdentifier": { "const": "Apache-2.0" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "signoffPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireEveryCommitAuthor", "requireEveryCoauthor", "identityMatch", "allowGitHubNoreplyEmail"],
      "properties": {
        "requireEveryCommitAuthor": { "const": true },
        "requireEveryCoauthor": { "const": true },
        "identityMatch": { "const": "name-and-email-case-insensitive" },
        "allowGitHubNoreplyEmail": { "const": true }
      }
    },
    "botExemptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/botExemption" }
    },
    "largeOrCorporateContributions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "action"],
      "properties": {
        "threshold": { "const": "maintainer-discretion-for-ownership-complexity-size-or-patent-risk" },
        "action": { "const": "separate-written-agreement-before-merge" }
      }
    },
    "blockers": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "botExemption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubLogin", "githubUserId", "reason", "approvedBy", "approvedAt"],
      "properties": {
        "githubLogin": { "type": "string", "pattern": "^[A-Za-z0-9-]+\\[bot\\]$" },
        "githubUserId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "reason": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 2 },
        "approvedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
