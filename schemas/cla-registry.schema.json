{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lunifans/rinspace-web/schemas/cla-registry.schema.json",
  "title": "Rinspace public CLA registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "repository", "agreements", "publicRegistryFields", "records", "botExemptions", "operationalEvidence", "blockers"],
  "properties": {
    "$schema": { "const": "../schemas/cla-registry.schema.json" },
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["disabled", "operational"] },
    "repository": { "const": "lunifans/rinspace-web" },
    "agreements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["individual", "corporate", "privacyNotice"],
      "properties": {
        "individual": { "$ref": "#/$defs/agreement" },
        "corporate": { "$ref": "#/$defs/agreement" },
        "privacyNotice": { "$ref": "#/$defs/agreement" }
      }
    },
    "publicRegistryFields": {
      "const": ["githubLogin", "githubUserId", "agreementType", "agreementSha256", "privacyNoticeSha256", "acceptedAt", "evidenceRef"]
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    },
    "botExemptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/botExemption" }
    },
    "operationalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signingIntake", "privateRecordStore", "encryptedBackup", "crossBorderControl", "branchProtection"],
      "properties": {
        "signingIntake": { "$ref": "#/$defs/nullableEvidence" },
        "privateRecordStore": { "$ref": "#/$defs/nullableEvidence" },
        "encryptedBackup": { "$ref": "#/$defs/nullableEvidence" },
        "crossBorderControl": { "$ref": "#/$defs/nullableEvidence" },
        "branchProtection": { "$ref": "#/$defs/nullableEvidence" }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableEvidence": { "type": ["string", "null"], "pattern": "^evidence:[A-Za-z0-9._/-]+$" },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "enum": ["ICLA.md", "CCLA.md", "CLA-PRIVACY.md"] },
        "version": { "const": "1.0" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubLogin", "githubUserId", "agreementType", "agreementSha256", "privacyNoticeSha256", "acceptedAt", "evidenceRef"],
      "properties": {
        "githubLogin": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
        "githubUserId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "agreementType": { "enum": ["individual", "corporate"] },
        "agreementSha256": { "$ref": "#/$defs/sha256" },
        "privacyNoticeSha256": { "$ref": "#/$defs/sha256" },
        "acceptedAt": { "$ref": "#/$defs/timestamp" },
        "evidenceRef": { "type": "string", "pattern": "^private-cla-record:[A-Za-z0-9._-]+$" }
      }
    },
    "botExemption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubLogin", "githubUserId", "reason", "approvedBy", "approvedAt"],
      "properties": {
        "githubLogin": { "type": "string", "minLength": 1 },
        "githubUserId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "reason": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
