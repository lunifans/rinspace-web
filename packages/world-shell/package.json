{
  "name": "@rinspace/world-shell",
  "version": "0.1.1",
  "description": "Shared world routing and topbar shell for Rinspace Web runtimes",
  "type": "module",
  "license": "AGPL-3.0-only",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./world-routes": {
      "types": "./dist/generated/world-routes.d.ts",
      "import": "./dist/generated/world-routes.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-world-shell-assets.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
